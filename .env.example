# BlueMoon BFMS localhost configuration.
# Copy to .env and replace all three password placeholders.
# Keep .env local. See docs/03_operations_and_guides/local-development.md.

# Docker PostgreSQL bootstrap account and loopback port.
POSTGRES_OWNER_USERNAME=bluemoon_owner
POSTGRES_OWNER_PASSWORD=replace-with-local-owner-password
POSTGRES_LOCAL_PORT=5432

# Application database account. Match the port in DB_URL to POSTGRES_LOCAL_PORT.
DB_URL=jdbc:postgresql://127.0.0.1:5432/bluemoon
DB_USERNAME=bluemoon_app
DB_PASSWORD=replace-with-local-app-password
JPA_DDL_AUTO=validate

# Loopback-only application and temporary Sprint 1 demo login.
PORT=8080
server.address=127.0.0.1
spring.security.user.name=admin
spring.security.user.password=replace-with-local-demo-password

# ==============================================================================
# BlueMoon BFMS - Environment Variables Template
# Copy file này thành .env hoặc thiết lập các biến này trên máy cá nhân / IDE.
# KHÔNG commit file chứa password thật lên GitHub repository.
# ==============================================================================

# 1. Cấu hình khi kết nối Google Cloud PostgreSQL (Cloud SQL hoặc GCP VM):
# Ví dụ: jdbc:postgresql://34.123.45.67:5432/bluemoon?sslmode=prefer
DB_URL=jdbc:postgresql://<GCP_HOST_OR_IP>:5432/bluemoon?sslmode=prefer
DB_USERNAME=bluemoon_admin
DB_PASSWORD=your_secure_password_here

# 2. Cấu hình khi chạy PostgreSQL Local qua Docker Compose hoặc Postgres Service:
# DB_URL=jdbc:postgresql://localhost:5432/bluemoon
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# 3. Cổng chạy ứng dụng (mặc định 8080)
PORT=8080
